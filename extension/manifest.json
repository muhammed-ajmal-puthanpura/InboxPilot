{
  "manifest_version": 3,
  "name": "InboxPilot - AI Email Tracker",
  "version": "1.0",
  "description": "AI-powered status tracking and follow-up generator for Gmail.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "InboxPilot"
  }
}